.markdown-body th, .markdown-body td {
    border: 1px solid var(--border);
    padding: 6px 10px;
    text-align: left;
}
.markdown-body th {
    background: var(--bg-tertiary);
    font-weight: 600;
}
.markdown-body tr:nth-child(even) {
    background: var(--bg-secondary);
}

/* --- Thinking markdown (inside thinking card) --- */
.thinking-markdown {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    font-style: italic;
}
.thinking-markdown p {
    margin-bottom: 0.5em;
}
.thinking-markdown pre {
    margin: 0.5em 0;
}
.thinking-markdown code {
    font-style: normal;
}
