# Copy to .env; never commit populated credentials.
# Deployment environment > .env. NOTION_ACCOUNTS > accounts.json.
# Use python login.py to populate accounts.json, or uncomment an explicit pool:
# NOTION_ACCOUNTS='[{"token_v2":"replace-me","space_id":"replace-me","user_id":"replace-me"}]'

# Required unless explicitly using trusted-local unauthenticated mode.
# Generate a random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
ALLOW_UNAUTHENTICATED=false

# Local process defaults. Docker overrides its internal binding separately.
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# standard: supplied full history; no memory database needed.
# lite: last user prompt only. heavy: SQLite archive + bounded memory.
APP_MODE=standard
DB_PATH=./data/conversations.db

# Per-process limits. Run one worker; these are not distributed tenant quotas.
MAX_CONCURRENT_REQUESTS=4
MAX_REQUEST_BYTES=1048576
REQUESTS_PER_MINUTE=20

# Docker host binding. Keep loopback or put an authenticated TLS proxy in front.
HOST_BIND=127.0.0.1
HOST_PORT=8000

# Optional: enabling this sends older user/assistant turns to SiliconFlow.
# Missing/failed summarization leaves raw archived history intact and reports degradation.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# Update only after checking upstream protocol compatibility.
# NOTION_CLIENT_VERSION=23.13.20260228.0625
LOG_LEVEL=INFO
TZ=UTC
